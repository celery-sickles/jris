@Conference{11253819,
  author={Turnip, Peri and Joelianto, Endra and Mukhlish, Faqihza and Nadhira, Vebi and Turnip, Arjon and Burohman, Azka Muji},
  booktitle={2025 9th International Conference on Instrumentation, Control, and Automation {(ICA)}}, 
  volume= {},
  title={Comparative Analysis of Machine Learning Algorithms for Traffic Prediction in Intelligent Transportation Systems}, 
  year={2025},
  publisher = {IEEE},
  pages={196-200},
  abstract = {Traffic prediction is a critical element of Intelligent Transportation Systems (ITS), enhancing road safety, traffic flow, and environmental sustainability. By leveraging big data and machine learning, ITS optimizes fuel consumption, route planning, and traffic signal control. This study evaluates the performance of four machine learning models—K-Nearest Neighbors (KNN), Naïve Bayes, Decision Tree, and Random Forest—for classifying traffic conditions based on 11 months of vehicle count data collected every 15 minutes. The traffic levels are categorized into four classes: Heavy Traffic, Medium Traffic, No Traffic, and Traffic Jam. Among the models, Random Forest achieved the highest overall accuracy (99%) and delivered strong precision and recall across all traffic levels, especially in distinguishing between complex traffic patterns. KNN also showed high accuracy but required more computational resources. Decision Tree performed comparably, particularly for Heavy Traffic, while Naïve Bayes struggled with lower precision and recall due to its limitations in handling complex data distributions. The results underscore the robustness of Random Forest for real-time traffic condition classification and support its integration into ITS for effective, data-driven traffic and congestion management in urban environments.},
  doi={https://doi.org/10.1109/ICA65945.2025.11253819},
  source = {IEEE},
  annote={The study compared four machine learning algorithms used for traffic prediction: K-Nearest Neighbors (KNN), Naïve Bayes, 
Decision Tree, and Random Forest. The algorithms received data on vehicle count in a given location and had to classify
it as high traffic, medium traffic, no traffic, and traffic jam. 
Random Forest performed the best, with K-Nearest Neighbors close behind but slightly
hampered by its high computational resource requirement. Naïve Bayers performed the worst in terms of precision and 
recall. The article is published in IEEE and was published recently (2025), so its crediblity and relevance is relatively
high, however, it only has 5 full text views, which may detract from its credibility.}
}
